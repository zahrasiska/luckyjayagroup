# =============================================================================
# Copilot Orchestrator Environment Configuration
# =============================================================================
# Copy this file to .env and configure according to your environment

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration (for MCP ltech-db server)
# -----------------------------------------------------------------------------
# Database connection settings untuk tool ltech-db-query
PGHOST=localhost
PGDATABASE=luckyjayagroup
PGUSER=postgres
PGPASSWORD=your_password_here
PGPORT=5432

# Default tenant schema (OPTIONAL - agent will decide based on business context)
# Only set this if you want to override agent decision
# PGSCHEMA=u1566482_sparepart

# -----------------------------------------------------------------------------
# Global Memory Configuration (for MCP ltech-memory server)
# -----------------------------------------------------------------------------
# Path ke file CORE_MEMORY.md untuk persistent knowledge base
# Default: ./knowledge/CORE_MEMORY.md
MEMORY_PATH=/home/luckyjayagroup/ltech/ltech-backend/ai/copilot-orchestrator/knowledge/CORE_MEMORY.md

# -----------------------------------------------------------------------------
# Copilot CLI Configuration
# -----------------------------------------------------------------------------
# Model default untuk semua agent (options: gpt-4.1, gpt-5-mini, claude-haiku-4.5, dll)
# Recommend: gpt-4.1 (36% faster, free)
COPILOT_MODEL=gpt-4.1

# Timeout untuk execution (dalam ms)
# Default: 180000 (3 menit)
COPILOT_TIMEOUT=180000

# -----------------------------------------------------------------------------
# Pipeline Orchestrator Configuration
# -----------------------------------------------------------------------------
# Mode verbose untuk debugging
VERBOSE=false

# Auto-approve tools (YOLO mode)
# Default: true untuk production
AUTO_APPROVE_TOOLS=true

# -----------------------------------------------------------------------------
# Session Management
# -----------------------------------------------------------------------------
# Session storage path (default: ~/.copilot/session-state/)
# SESSION_STATE_PATH=~/.copilot/session-state/

# -----------------------------------------------------------------------------
# Notes:
# -----------------------------------------------------------------------------
# 1. File ini adalah template. Copy ke .env sebelum digunakan:
#    cp .env.example .env
#
# 2. Untuk security, jangan commit file .env ke git!
#    Sudah ada di .gitignore
#
# 3. Environment variables bisa dioverride saat runtime:
#    PGSCHEMA=prive node pipeline-orchestrator.js
#
# 4. MCP servers akan otomatis loaded oleh Copilot CLI
#    via ~/.copilot/mcp-config.json
